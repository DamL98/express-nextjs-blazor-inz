@page "/reservations"
@implements IDisposable
@using FrontendBlazor.Client.Components
@using FrontendBlazor.Client.Formatting
@using FrontendBlazor.Client.Infrastructure.Api
@using FrontendBlazor.Client.Models
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Moje rezerwacje</PageTitle>

<section
    class="mx-auto max-w-5xl px-6 py-8"
    data-measurement-page="reservations"
    data-measurement-state="@(_isLoading ? "loading" : _loadError is null ? "ready" : "error")"
    data-measurement-count="@_reservations.Count">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Moje rezerwacje</h1>
            <p class="mt-2 text-gray-600">Lista Twoich rezerwacji.</p>
        </div>

        <a class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" href="/rooms">Zarezerwuj sale</a>
    </div>

    <div class="mt-6">
        <GoogleCalendarIntegrationCard
            CallbackStatus="GoogleCalendarCallbackStatus"
            CallbackReason="GoogleCalendarCallbackReason" />
    </div>

    <div class="mt-6">
        @if (_isLoading)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-6 text-gray-600 shadow-sm">Ladowanie rezerwacji...</div>
        }
        else if (_loadError is not null)
        {
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">@_loadError</div>
        }
        else if (_reservations.Count == 0)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-6 text-gray-600 shadow-sm">
                <a class="text-sm font-medium text-blue-600 hover:text-blue-700" href="/rooms">← back /rooms</a>
                Nie masz jeszcze zadnych rezerwacji
            </div>
        }
        else
        {
            <section class="space-y-4">
                @if (_actionError is not null)
                {
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">@_actionError</div>
                }

                @foreach (var reservation in _reservations)
                {
                    <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">@reservation.Title</h2>
                                <p class="mt-1 text-sm text-gray-600">@(reservation.Room?.Name ?? $"Sala: {reservation.RoomId}")</p>
                            </div>

                            <span class="@($"inline-flex w-fit rounded-full border px-3 py-1 text-xs font-medium {reservation.Status switch
                                {
                                    ReservationStatus.ACTIVE => "border-green-200 bg-green-50 text-green-700",
                                    _ => "border-gray-200 bg-gray-50 text-gray-600",
                                }}")">
                                @(reservation.Status switch
                                {
                                    ReservationStatus.ACTIVE => "Aktywna",
                                    ReservationStatus.CANCELLED => "Anulowana",
                                    _ => reservation.Status.ToString(),
                                })
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(reservation.Description))
                        {
                            <p class="mt-4 text-sm text-gray-700">@reservation.Description</p>
                        }

                        <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
                            <div>
                                <dt class="text-gray-500">Poczatek</dt>
                                <dd class="font-medium text-gray-900">@DateTimeFormatter.Format(reservation.StartTime)</dd>
                            </div>

                            <div>
                                <dt class="text-gray-500">Koniec</dt>
                                <dd class="font-medium text-gray-900">@DateTimeFormatter.Format(reservation.EndTime)</dd>
                            </div>
                        </dl>

                        @if (reservation.Status == ReservationStatus.ACTIVE)
                        {
                            <button
                                type="button"
                                class="mt-5 rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60"
                                disabled="@(_pendingReservationId == reservation.Id)"
                                @onclick="() => CancelReservationAsync(reservation.Id)">
                                @(_pendingReservationId == reservation.Id
                                    ? "Anulowanie..."
                                    : "Anuluj rezerwacje")
                            </button>
                        }
                    </article>
                }
            </section>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource _requestCancellation = new();
    private IReadOnlyList<ReservationDto> _reservations = [];
    private bool _isLoading = true;
    private string? _loadError;
    private string? _actionError;
    private string? _pendingReservationId;

    [SupplyParameterFromQuery(Name = "googleCalendar")]
    private string? GoogleCalendarCallbackStatus { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    private string? GoogleCalendarCallbackReason { get; set; }

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (!isFirstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            _reservations = await Api.ApiRequestAsync<IReadOnlyList<ReservationDto>>(
                "/reservations/my",
                new ApiRequestOptions
                {
                    IsBrowserCredentialRequired = true,
                },
                _requestCancellation.Token);
        }
        catch (OperationCanceledException) when (_requestCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _loadError = ApiErrorMessage.FromException(
                exception,
                "Blad pobierania rezerwacji");
        }
        finally
        {
            _isLoading = false;
        }

        if (!_requestCancellation.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    private async Task CancelReservationAsync(string reservationId)
    {
        var isConfirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Czy na pewno chcesz anulowac te rezerwacje?");

        if (!isConfirmed)
        {
            return;
        }

        _pendingReservationId = reservationId;
        _actionError = null;

        try
        {
            var cancelledReservation = await Api.ApiRequestAsync<ReservationDto>(
                $"/reservations/{Uri.EscapeDataString(reservationId)}/cancel",
                new ApiRequestOptions
                {
                    Method = HttpMethod.Patch,
                    IsBrowserCredentialRequired = true,
                });
            _reservations = _reservations
                .Select(reservation => reservation.Id == reservationId
                    ? cancelledReservation
                    : reservation)
                .ToList();
        }
        catch (Exception exception)
        {
            _actionError = ApiErrorMessage.FromException(
                exception,
                "Blad anulowania rezerwacji");
        }
        finally
        {
            _pendingReservationId = null;
        }
    }

    public void Dispose()
    {
        _requestCancellation.Cancel();
        _requestCancellation.Dispose();
    }
}
