@page "/reservations"
@implements IDisposable
@using FrontendBlazor.Client.Infrastructure.Api
@inject ApiClient Api

<PageTitle>Moje rezerwacje</PageTitle>

<section
    class="mx-auto max-w-6xl px-4 py-8 md:px-8 md:py-10"
    data-measurement-page="reservations"
    data-measurement-state="@(_loading ? "loading" : _loadError is null ? "ready" : "error")"
    data-measurement-count="@_reservations.Count"
    >

    <PageHeader
        Title="Moje rezerwacje"
        Description="Sprawdź nadchodzące spotkania, historię i anulowane rezerwacje."
    >
        <a href="/rooms" class="rounded-xl bg-blue-900 px-5 py-3 text-sm font-semibold text-white">
            <AppIcon Name="calendar-plus" />
            Zarezerwuj salę
        </a>
    </PageHeader>

    @if (_loading)
    {
        <LoadingCards />
    }
    else if (_loadError is not null)
    {
        <ErrorNotice Message="@_loadError" />
    }
    else if (_reservations.Count == 0)
    {
        <EmptyState Title="Nie masz jeszcze rezerwacji" Description="Znajdź salę dopasowaną do spotkania i wybierz pierwszy termin.">
            <a href="/rooms" class="text-blue-700">Zarezerwuj salę</a>
        </EmptyState>
    }
    else
    {
        var filtered = Filtered.ToList();

        <section class="space-y-5" aria-label="Lista rezerwacji">
            <div class="rounded-2xl border border-app-line bg-white p-4 sm:p-5">
                <div role="group" aria-label="Okres rezerwacji" class="flex flex-wrap gap-2">

                @foreach (var tab in Tabs)
                { <button type="button" aria-pressed="@(_tab == tab.Key)" @onclick="() => _tab = tab.Key" class="@($"rounded-xl px-4 py-3 text-sm font-semibold {(_tab == tab.Key ? "bg-blue-900 text-white" : "bg-slate-50 text-app-muted")}")">@tab.Label <span class="ml-1 opacity-75">@_reservations.Count(r => tab.Key == "all" || ViewFilters.Group(r, _now) == tab.Key)</span></button> }
                </div>
                <label class="mt-5 block text-sm font-medium">Znajdź rezerwację<input id="reservation-search" type="search" @bind="_search" @bind:event="oninput" placeholder="Tytuł spotkania lub nazwa sali…" class="mt-2 min-h-11 w-full rounded-xl border border-app-line px-4 py-2" /></label><p role="status" class="mt-3 text-xs text-app-muted">Widoczne rezerwacje: @filtered.Count</p>
            </div>

            @if (_message is not null)
            {
                <p role="status" class="rounded-xl border border-teal-200 bg-teal-50 p-4 text-sm text-teal-800">
                    @_message
                </p>
            }

            @if (filtered.Count == 0)
            {
                <EmptyState Title="Brak rezerwacji w tym widoku" Description="Wybierz inny okres lub usuń wpisaną frazę.">
                    <button type="button" @onclick="ShowAll" class="text-blue-700">Pokaż wszystkie</button>
                </EmptyState>
            }

            @foreach (var reservation in filtered)
            {
                var group = ViewFilters.Group(reservation, _now);
                var label = group == "cancelled" ? "Anulowana" : group == "history" ? "Zakończona" : reservation.StartTime <= _now ? "W trakcie" : "Nadchodząca";
                <article data-measurement-reservation-id="@reservation.Id" @key="reservation.Id" class="rounded-2xl border border-app-line bg-white p-5 shadow-sm sm:p-6"><div class="flex flex-col gap-4 xl:flex-row xl:items-center"><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-3"><h2 class="break-words text-base font-bold">@reservation.Title</h2><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold">@label</span></div><a href="@($"/rooms/{Uri.EscapeDataString(reservation.RoomId)}")" class="mt-2 inline-block text-sm font-medium text-blue-700">@(reservation.Room?.Name ?? $"Sala: {reservation.RoomId}")</a><p class="mt-2 text-sm leading-6 text-app-muted">@DateTimeFormatter.Format(reservation.StartTime) — @DateTimeFormatter.Format(reservation.EndTime)</p></div>
                @if (reservation.Status == ReservationStatus.ACTIVE)
                    { <button
                        type="button" disabled="@_busy" @onclick="() => Select(reservation)" class="shrink-0 rounded-xl border border-red-200 px-4 py-3 text-sm font-medium text-red-700"><AppIcon Name="calendar-x" />Anuluj rezerwację</button> }
                </div>
                @if (!string.IsNullOrWhiteSpace(reservation.Description)) { <details class="mt-4 border-t border-slate-100 pt-4"><summary class="cursor-pointer text-sm font-medium text-app-muted">Opis spotkania</summary><p class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-app-muted">@reservation.Description</p></details> }
                </article>
            }
        </section>
    }
    <details open="@(GoogleLink is not null || CalendarStatus is not null)" class="mt-8 rounded-2xl border border-app-line bg-white p-5"><summary class="cursor-pointer text-sm font-semibold">Konto i integracja kalendarza</summary><p class="mt-3 text-sm text-app-muted">Ustawienia na osobnej stronie. <a href="/settings" class="text-blue-700 underline">Przejdź do ustawień</a></p><div class="mt-5 space-y-5"><AccountSecurityCard /><GoogleCalendarIntegrationCard CallbackStatus="@CalendarStatus" CallbackReason="@Reason" /></div></details>
    @if (_selected is not null) { <CancelReservationDialog Reservation="_selected" Busy="_busy" Error="@_actionError" OnClose="Close" OnConfirm="CancelAsync" /> }
</section>
@code {
    private static readonly (string Key, string Label)[] Tabs = [("upcoming", "Nadchodzące"), ("history", "Historia"), ("cancelled", "Anulowane"), ("all", "Wszystkie")];
    private readonly CancellationTokenSource _cancellation = new();
    private IReadOnlyList<ReservationDto> _reservations = [];
    private ReservationDto? _selected;
    private bool _loading = true, _busy;
    private string? _loadError, _actionError, _message;
    private string _tab = "upcoming", _search = "";
    private DateTimeOffset _now = DateTimeOffset.Now;
    private PeriodicTimer? _timer;
    [SupplyParameterFromQuery(Name = "googleCalendar")] public string? CalendarStatus { get; set; }
    [SupplyParameterFromQuery(Name = "googleLink")] public string? GoogleLink { get; set; }
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }
    private IEnumerable<ReservationDto> Filtered {
        get {
            var rows = _reservations.Where(r => (_tab == "all" || ViewFilters.Group(r, _now) == _tab) && System.Globalization.CultureInfo.GetCultureInfo("pl-PL").CompareInfo.IndexOf($"{r.Title} {r.Room?.Name}", _search.Trim(), System.Globalization.CompareOptions.IgnoreCase) >= 0);
            return _tab == "upcoming" ? rows.OrderBy(r => r.StartTime) : rows.OrderByDescending(r => r.StartTime);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        _ = TickAsync();
        try { _reservations = await Api.ApiRequestAsync<IReadOnlyList<ReservationDto>>("/reservations/my", cancellationToken: _cancellation.Token); }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex) { _loadError = ApiErrorMessage.FromException(ex, "Błąd pobierania rezerwacji"); }
        finally { _loading = false; }
    }
    private async Task TickAsync() {
        try { while (await _timer!.WaitForNextTickAsync(_cancellation.Token)) await InvokeAsync(() => { _now = DateTimeOffset.Now; StateHasChanged(); }); }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
    }
    private void ShowAll() { _search = ""; _tab = "all"; }
    private void Select(ReservationDto item) { _selected = item; _actionError = null; }
    private void Close() { if (!_busy) _selected = null; }
    private async Task CancelAsync()
    {
        if (_busy || _selected is null) return;
        _busy = true; _actionError = _message = null;
        try {
            var result = await Api.ApiRequestAsync<ReservationDto>($"/reservations/{Uri.EscapeDataString(_selected.Id)}/cancel", new ApiRequestOptions { Method = HttpMethod.Patch }, _cancellation.Token);
            _reservations = _reservations.Select(r => r.Id == result.Id ? result : r).ToList();
            _selected = null; _message = "Rezerwacja anulowana. Znajdziesz ją w zakładce Anulowane.";
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex) { _actionError = ApiErrorMessage.FromException(ex, "Błąd anulowania rezerwacji"); }
        finally { _busy = false; }
    }
    public void Dispose() { _cancellation.Cancel(); _timer?.Dispose(); _cancellation.Dispose(); }
}
