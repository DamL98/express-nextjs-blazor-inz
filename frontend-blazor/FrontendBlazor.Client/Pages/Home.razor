@page "/"
@implements IDisposable
@using FrontendBlazor.Client.Infrastructure.Api
@inject ApiClient Api
<PageTitle>Twój plan spotkań</PageTitle>
<section class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-10" data-measurement-page="dashboard" data-measurement-state="@(_isLoading ? "loading" : _errorMessage is null ? "ready" : "error")">
    <PageHeader Title="Twój plan spotkań" Description="Najbliższe rezerwacje i dostęp do sal — wszystko, czego potrzebujesz na początek dnia."><a href="/rooms" class="rounded-xl bg-blue-900 px-5 py-3 text-sm font-semibold text-white"><AppIcon Name="calendar-plus" />Zarezerwuj salę</a></PageHeader>
    @if (_isLoading) { <LoadingCards /> }
    else if (_errorMessage is not null) { <ErrorNotice Message="@_errorMessage" /> }
    else
    {
        var next = _nextReservations.FirstOrDefault();
        <section aria-label="Podsumowanie" class="grid gap-5 lg:grid-cols-3">
            <div class="overflow-hidden rounded-2xl bg-blue-950 p-6 text-white sm:p-8 lg:col-span-2"><p class="text-xs font-semibold uppercase tracking-widest text-blue-200">Najbliższe spotkanie</p><h2 class="mt-5 break-words text-2xl font-bold">@(next?.Title ?? "Przestrzeń na nowe plany")</h2>
                @if (next is not null) { <p class="mt-3 text-sm leading-6 text-blue-100">@DateTimeFormatter.Format(next.StartTime) — @DateTimeFormatter.Format(next.EndTime)</p><p class="mt-2 text-sm text-blue-200">@next.Room?.Name · @next.Room?.Location</p><a href="@($"/rooms/{Uri.EscapeDataString(next.RoomId)}")" class="mt-6 inline-block rounded-xl bg-white px-4 py-3 text-sm font-semibold text-blue-950">Szczegóły sali <AppIcon Name="arrow-right" /></a> }
                else { <p class="mt-3 text-sm text-blue-100">Nie masz nadchodzących rezerwacji. Wybierz salę i zaplanuj kolejne spotkanie.</p> }
            </div>
            <div class="flex flex-col rounded-2xl border border-app-line bg-white p-6 sm:p-8"><p class="text-sm font-medium text-app-muted">Aktywne sale</p><p class="mt-4 text-5xl font-bold">@_activeRoomsCount</p><p class="mt-3 text-sm leading-6 text-app-muted">Sale dostępne do rezerwacji. Wolny termin zależy od harmonogramu sali.</p><a href="/rooms" class="mt-auto pt-5 text-sm font-semibold text-blue-700">Przeglądaj sale <AppIcon Name="arrow-right" /></a></div>
        </section>
        <section class="mt-8 overflow-hidden rounded-2xl border border-app-line bg-white"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-app-line p-6"><h2 class="text-lg font-bold"><AppIcon Name="calendar-days" />Najbliższe rezerwacje</h2><a href="/reservations" class="text-sm font-semibold text-blue-700">Zobacz wszystkie</a></div>
            @if (_nextReservations.Count == 0) { <div class="p-5"><EmptyState Title="Twój kalendarz jest jeszcze pusty" Description="Pierwsza rezerwacja pojawi się tutaj po zapisaniu spotkania."><a href="/rooms" class="text-blue-700">Znajdź salę</a></EmptyState></div> }
            else { <div class="divide-y divide-slate-100">@foreach (var reservation in _nextReservations) { <article class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center"><div class="min-w-0 flex-1"><h3 class="break-words font-semibold">@reservation.Title</h3><p class="mt-1 text-sm text-app-muted">@(reservation.Room?.Name ?? $"Sala: {reservation.RoomId}")</p><p class="mt-2 text-sm text-app-muted">@DateTimeFormatter.Format(reservation.StartTime) — @DateTimeFormatter.Format(reservation.EndTime)</p></div><a href="@($"/rooms/{Uri.EscapeDataString(reservation.RoomId)}")" class="rounded-xl border border-app-line px-4 py-3 text-center text-sm font-medium">Zobacz salę</a></article> }</div> }
        </section>
    }
    <ReservationCalendar />
</section>
@code {
    private readonly CancellationTokenSource _requestCancellation = new();
    private IReadOnlyList<ReservationDto> _nextReservations = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private int _activeRoomsCount;

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (!isFirstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            var dashboard = await Api.ApiRequestAsync<DashboardDto>(
                "/dashboard",
                new ApiRequestOptions
                {
                    IsBrowserCredentialRequired = true,
                },
                _requestCancellation.Token);
            _activeRoomsCount = dashboard.ActiveRoomsCount;
            _nextReservations = dashboard.NextReservations;
        }
        catch (OperationCanceledException) when (_requestCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = ApiErrorMessage.FromException(
                exception,
                "Blad pobierania danych do dashboard");
        }
        finally
        {
            _isLoading = false;
        }

        if (!_requestCancellation.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _requestCancellation.Cancel();
        _requestCancellation.Dispose();
    }
}
