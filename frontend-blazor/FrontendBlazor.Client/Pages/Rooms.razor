@page "/rooms"
@implements IDisposable
@using FrontendBlazor.Client.Features.Rooms
@using FrontendBlazor.Client.Features.Rooms.DTOs
@using FrontendBlazor.Client.Infrastructure.Api
@inject RoomsApi RoomsApi

<PageTitle>Sale</PageTitle>

<section
    class="rooms-page"
    data-measurement-page="rooms"
    data-measurement-state="@GetMeasurementState()"
    data-measurement-count="@_rooms.Count">
    <header class="rooms-header">
        <h1>Lista sal</h1>
        <p>Wybierz salę</p>
    </header>

    @if (_isLoading)
    {
        <div class="state-card">Ładowanie sal...</div>
    }
    else if (_errorMessage is not null)
    {
        <div class="state-card error-state" role="alert">@_errorMessage</div>
    }
    else if (_rooms.Count == 0)
    {
        <div class="state-card">Brak sal do wyświetlenia</div>
    }
    else
    {
        <div class="rooms-grid">
            @foreach (var room in _rooms)
            {
                <article class="room-card">
                    <h2>@room.Name</h2>
                    <p class="room-location">@room.Location</p>
                    <p class="room-capacity">Liczba miejsc: @room.Capacity</p>
                    <p class="room-status">@(room.IsActive ? "Aktywna" : "Nieaktywna")</p>
                    <a class="details-link" href="@($"/rooms/{room.Id}")">
                        Zobacz szczegóły
                    </a>
                </article>
            }
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource _requestCancellation = new();
    private IReadOnlyList<RoomDto> _rooms = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rooms = await RoomsApi.GetRoomsAsync(_requestCancellation.Token);
        }
        catch (OperationCanceledException) when (_requestCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = ApiErrorMessage.FromException(
                exception,
                "Błąd pobierania listy sal");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _requestCancellation.Cancel();
        _requestCancellation.Dispose();
    }

    private string GetMeasurementState()
    {
        return _isLoading ? "loading" : _errorMessage is null ? "ready" : "error";
    }
}
