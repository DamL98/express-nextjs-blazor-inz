@page "/rooms"
@implements IDisposable
@using FrontendBlazor.Client.Infrastructure.Api
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Sale</PageTitle>

<section
    class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-10"
    data-measurement-page="rooms"
    data-measurement-state="@(_loading ? "loading" : _error is null ? "ready" : "error")"
    data-measurement-count="@_rooms.Count">

    <PageHeader Title="Znajdź salę" Description="Wybierz przestrzeń dopasowaną do spotkania. Termin sprawdzisz podczas rezerwacji." />

    @if (_loading)
    {
        <LoadingCards />
    }
    else if (_error is not null)
    {
        <ErrorNotice Message="@_error" />
    }
    else if (_rooms.Count == 0)
    {
        <EmptyState Title="Brak sal do wyświetlenia" Description="Obecnie nie ma dostępnych sal" />
    }
    else
    {
        var filtered = ViewFilters.Rooms(_rooms, Search, Capacity, Active, Sort).ToList();

        <section aria-label="Wyszukiwanie sal" class="mb-6 rounded-2xl border border-app-line bg-white p-5 shadow-sm">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <label class="text-sm font-medium">
                    <AppIcon Name="search" />Nazwa lub lokalizacja
                    <input
                        type="search"
                        value="@Search"
                        @oninput='e => UpdateFilter("search", e.Value?.ToString())'
                        placeholder="Np. sala A, budynek B…"
                        class="mt-2 min-h-11 w-full rounded-xl border border-app-line px-3 py-2" />
                </label>
                <label class="text-sm font-medium">Minimalna liczba miejsc<input type="number" min="1" step="1" value="@Capacity" @oninput='e => UpdateFilter("capacity", e.Value?.ToString())' placeholder="Dowolna" class="mt-2 min-h-11 w-full rounded-xl border border-app-line px-3 py-2" /></label>
                <label class="text-sm font-medium">Możliwość rezerwacji<select value="@(Active is "true" or "false" ? Active : "all")" @onchange='e => UpdateFilter("active", e.Value?.ToString())' class="mt-2 min-h-11 w-full rounded-xl border border-app-line bg-white px-3 py-2"><option value="all">Wszystkie sale</option><option value="true">Aktywne</option><option value="false">Wyłączone z rezerwacji</option></select></label>
                <label class="text-sm font-medium">Sortowanie<select value="@(Sort is "capacity-asc" or "capacity-desc" ? Sort : "name")" @onchange='e => UpdateFilter("sort", e.Value?.ToString())' class="mt-2 min-h-11 w-full rounded-xl border border-app-line bg-white px-3 py-2"><option value="name">Nazwa: A–Z</option><option value="capacity-asc">Liczba miejsc: rosnąco</option><option value="capacity-desc">Liczba miejsc: malejąco</option></select></label>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4"><p role="status" class="text-sm text-app-muted">Wyniki: <strong>@filtered.Count</strong> z @_rooms.Count sal</p><button type="button" @onclick="ClearFilters" class="rounded-lg px-3 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">Wyczyść filtry</button></div>
        </section>

        @if (filtered.Count == 0)
        {
            <EmptyState Title="Nie znaleziono sal" Description="Zmień nazwę, lokalizację lub wymaganą liczbę miejsc. Możesz też wyczyścić filtry." />
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var room in filtered)
                {
                    <article data-measurement-room-id="@room.Id" @key="room.Id" class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-app-line bg-white shadow-sm transition hover:border-blue-300 hover:shadow-md">
                        <div class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-5 py-4"><AppIcon Name="building-2" Class="size-6 text-blue-800" /><span class="rounded-full bg-white px-3 py-1 text-sm font-semibold"><AppIcon Name="users" />@room.Capacity miejsc</span></div>
                        <div class="flex flex-1 flex-col p-5"><h2 class="break-words text-lg font-bold">@room.Name</h2><p class="mt-1 break-words text-sm text-app-muted"><AppIcon Name="map-pin" />@room.Location</p><p class="mt-4 line-clamp-2 text-sm leading-6 text-app-muted">@(room.Description ?? "Sprawdź szczegóły sali i wybierz termin swojego spotkania.")</p><p class="mt-5 text-xs font-medium text-app-muted">@(room.IsActive ? "Aktywna · termin sprawdzisz przy rezerwacji" : "Wyłączona z rezerwacji")</p>
                        <a href="@($"/rooms/{Uri.EscapeDataString(room.Id)}{new Uri(Navigation.Uri).Query}")" class="mt-5 block rounded-xl bg-blue-900 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-blue-800"><AppIcon Name="calendar-plus" />@(room.IsActive ? "Wybierz termin" : "Zobacz szczegóły")<span class="sr-only">: @room.Name</span></a></div>
                    </article>
                }
            </div>
        }
    }
</section>
@code {
    private readonly CancellationTokenSource _cancellation = new();
    private IReadOnlyList<RoomDto> _rooms = [];
    private bool _loading = true;
    private string? _error;
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "capacity")] public string? Capacity { get; set; }
    [SupplyParameterFromQuery(Name = "active")] public string? Active { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    private void UpdateFilter(string name, string? value) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(name, string.IsNullOrEmpty(value) ? null : value), replace: true);
    private void ClearFilters() => Navigation.NavigateTo("/rooms", replace: true);
    protected override async Task OnInitializedAsync()
    {
        try { _rooms = await Api.ApiRequestAsync<IReadOnlyList<RoomDto>>("/rooms", cancellationToken: _cancellation.Token); }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex) { _error = ApiErrorMessage.FromException(ex, "Błąd pobierania listy sal"); }
        finally { _loading = false; }
    }
    public void Dispose() { _cancellation.Cancel(); _cancellation.Dispose(); }
}
