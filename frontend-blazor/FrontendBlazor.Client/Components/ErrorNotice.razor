@inject NavigationManager Navigation
<div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 text-sm text-red-800"><p class="font-semibold">Nie udało się wczytać danych</p><p class="mt-2 break-words">@Message</p><button type="button" class="mt-3 rounded-lg border border-red-200 bg-white px-4 py-2 font-semibold" @onclick="Retry"><AppIcon Name="refresh-cw" />Spróbuj ponownie</button></div>
@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    private async Task Retry() { if (OnRetry.HasDelegate) await OnRetry.InvokeAsync(); else Navigation.Refresh(true); }
}
