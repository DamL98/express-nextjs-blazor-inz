<div role="status" aria-label="Ładowanie danych" class="grid gap-4 sm:grid-cols-2"><span class="sr-only">Ładowanie danych…</span>
@for (var i = 0; i < Count; i++)
{ <div aria-hidden="true" class="animate-pulse rounded-2xl border border-app-line bg-white p-6"><div class="h-5 w-2/3 rounded bg-slate-200"></div><div class="mt-4 h-4 rounded bg-slate-100"></div><div class="mt-3 h-4 w-1/2 rounded bg-slate-100"></div></div> }
</div>
