<PageTitle>@(_room?.Name ?? "Szczegóły sali")</PageTitle>
<section
    class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-10"
    data-measurement-page="room-details"
    data-measurement-state="@(_loading ? "loading" : _error is null && _room is not null ? "ready" : "error")">
    <a href="@($"/rooms{new Uri(Navigation.Uri).Query}")" class="mb-6 inline-block rounded-lg py-2 text-sm font-semibold text-blue-700">
        <AppIcon Name="arrow-left" />
        Wróć do listy sal
    </a>
    @if (_loading)
    {
        <LoadingCards Count="2" />
    }
    else if (_error is not null || _room is null)
    {
        <ErrorNotice Message="@(_error ?? "Nie znaleziono sali")" />
    }
    else
    {
        <div class="grid items-start gap-6 xl:grid-cols-2">
            <section class="overflow-hidden rounded-2xl border border-app-line bg-white shadow-sm">
                <div class="flex items-end justify-between gap-4 bg-blue-950 p-7 text-white">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200">Przestrzeń do spotkań</p>
                        <h1 class="mt-4 break-words text-3xl font-bold tracking-tight">@_room.Name</h1>
                        <p class="mt-3 break-words text-sm text-blue-100">@_room.Location</p>
                    </div>
                    <span aria-hidden="true" class="text-4xl text-blue-300">
                        <AppIcon Name="building-2" ClassName="size-10" />
                    </span>
                </div>
                <div class="p-7">
                    <dl class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-xl bg-slate-50 p-4">
                            <dt class="text-xs text-app-muted">Liczba miejsc</dt>
                            <dd class="mt-2 text-2xl font-bold">@_room.Capacity</dd>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-4">
                            <dt class="text-xs text-app-muted">Status sali</dt>
                            <dd class="mt-2 text-sm font-semibold">@(_room.IsActive ? "Aktywna" : "Wyłączona z rezerwacji")</dd>
                        </div>
                    </dl>
                    <h2 class="mt-7 text-base font-bold">O sali</h2>
                    <p
                        class="mt-3 whitespace-pre-wrap break-words text-sm leading-7 text-app-muted">@(_room.Description ?? "Brak dodatkowego opisu. Lokalizację i liczbę miejsc znajdziesz powyżej.")</p>
                    <div class="mt-7 border-t border-app-line pt-5 text-sm leading-6 text-app-muted">
                        <p class="font-semibold">Jak zarezerwować?</p>
                        <ol class="mt-3 list-inside list-decimal space-y-2">
                            <li>Wybierz datę i godziny spotkania</li>
                            <li>Wpisz nazwę i sprawdź podsumowanie</li>
                            <li>Zapisz rezerwację — sprawdzimy termin</li>
                        </ol>
                    </div>
                </div>
            </section>
            @if (_room.IsActive)
            {
                <ReservationForm @key="_room.Id" RoomId="@_room.Id" RoomName="@_room.Name" />
            }
            else
            {
                <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
                    <h2 class="font-bold">Ta sala jest wyłączona z rezerwacji</h2>
                    <p class="mt-2">Wybierz inne miejsce, aby zaplanować spotkanie</p>
                    <a href="/rooms" class="mt-4 inline-block font-semibold underline">Przeglądaj pozostałe sale</a>
                </section>
            }
        </div>
    }
</section>
