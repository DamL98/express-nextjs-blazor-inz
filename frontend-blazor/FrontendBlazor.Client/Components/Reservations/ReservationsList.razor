@if (_reservations.Count == 0)
{
    <EmptyState Title="Nie masz jeszcze rezerwacji" Description="Znajdź salę dopasowaną do spotkania i wybierz pierwszy termin.">
        <a href="/rooms" class="text-blue-700">Zarezerwuj salę</a>
    </EmptyState>
}
else
{
    var filtered = FilteredReservations.ToList();
    <section class="space-y-5" aria-label="Lista rezerwacji">
        <div class="rounded-2xl border border-app-line bg-white p-4 sm:p-5">
            <div role="group" aria-label="Okres rezerwacji" class="flex flex-wrap gap-2">
                @foreach (var tab in Tabs)
                {
                    <button
                        type="button"
                        aria-pressed="@(_activeTab == tab.Key)"
                        @onclick="() => _activeTab = tab.Key"
                        class="@($"rounded-xl px-4 py-3 text-sm font-semibold {(_activeTab == tab.Key ? "bg-blue-900 text-white" : "bg-slate-50 text-app-muted")}")">
                        @tab.Label
                        <span class="ml-1 opacity-75">@_reservations.Count(r => tab.Key == ReservationGroup.All || ViewFilters.GetReservationGroup(r, _currentTime) == tab.Key)</span>
                    </button>
                }
            </div>
            <label class="mt-5 block text-sm font-medium">
                Znajdź rezerwację
                <input
                    id="reservation-search"
                    type="search"
                    @bind="_search"
                    @bind:event="oninput"
                    placeholder="Tytuł spotkania lub nazwa sali…"
                    class="mt-2 min-h-11 w-full rounded-xl border border-app-line px-4 py-2" />
            </label>
            <p role="status" class="mt-3 text-xs text-app-muted">Widoczne rezerwacje: @filtered.Count</p>
        </div>
        @if (_message is not null)
        {
            <p role="status" class="rounded-xl border border-teal-200 bg-teal-50 p-4 text-sm text-teal-800">
                @_message
            </p>
        }
        @if (filtered.Count == 0)
        {
            <EmptyState Title="Brak rezerwacji w tym widoku" Description="Wybierz inny okres lub usuń wpisaną frazę.">
                <button type="button" @onclick="ShowAll" class="text-blue-700">Pokaż wszystkie</button>
            </EmptyState>
        }
        @foreach (var reservation in filtered)
        {
            var group = GetGroup(reservation);
            var statusLabel = group == ReservationGroup.Cancelled ? "Anulowana"
                : group == ReservationGroup.History ? "Zakończona"
                : reservation.StartTime <= _currentTime ? "W trakcie" : "Nadchodząca";
            <article @key="reservation.Id" data-measurement-reservation-id="@reservation.Id" class="rounded-2xl border border-app-line bg-white p-5 shadow-sm sm:p-6">
                <div class="flex flex-col gap-4 xl:flex-row xl:items-center">
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-3">
                            <h2 class="break-words text-base font-bold">@reservation.Title</h2>
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold">@statusLabel</span>
                        </div>
                        <a
                            href="@($"/rooms/{Uri.EscapeDataString(reservation.RoomId)}")"
                            class="mt-2 inline-block text-sm font-medium text-blue-700">@(reservation.Room?.Name ?? $"Sala: {reservation.RoomId}")</a>
                        <p class="mt-2 text-sm leading-6 text-app-muted">@Formatters.FormatDateTime(reservation.StartTime) — @Formatters.FormatDateTime(reservation.EndTime)</p>
                    </div>
                    @if (reservation.Status == ReservationStatus.Active)
                    {
                        <button
                            type="button" disabled="@_busy" @onclick="() => SelectReservation(reservation)" class="shrink-0 rounded-xl border border-red-200 px-4 py-3 text-sm font-medium text-red-700">
                            <AppIcon Name="calendar-x" />
                            Anuluj rezerwację
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(reservation.Description))
                {
                    <details class="mt-4 border-t border-slate-100 pt-4">
                        <summary class="cursor-pointer text-sm font-medium text-app-muted">Opis spotkania</summary>
                        <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-app-muted">@reservation.Description</p>
                    </details>
                }
            </article>
        }
    </section>
}
@if (_selectedReservation is not null)
{
    <CancelReservationDialog Reservation="_selectedReservation" Busy="_busy" Error="@_actionError" OnClose="CloseDialog" OnConfirm="HandleCancelAsync" />
}
