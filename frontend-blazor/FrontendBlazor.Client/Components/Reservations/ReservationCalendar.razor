<section
    data-measurement-month="@_month.ToString("yyyy-MM", CultureInfo.InvariantCulture)"
    data-measurement-selected-day="@_selectedDay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
    aria-labelledby="reservation-calendar-title"
    aria-busy="@_loading"
    data-measurement-reservation-calendar="@(_loading ? "loading" : _error is null ? "ready" : "error")"
    class="mt-8 overflow-hidden rounded-2xl border border-app-line bg-white">
    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-app-line p-5 sm:p-6">
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-blue-700">Twój miesiąc</p>
            <h2 id="reservation-calendar-title" class="mt-2 text-xl font-bold">
                <AppIcon Name="calendar-days" />
                Kalendarz rezerwacji
            </h2>
            <p class="mt-2 text-sm leading-6 text-app-muted">Wybierz dzień, aby zobaczyć godziny spotkań i zarezerwowane sale</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button type="button" @onclick="ShowToday" class="rounded-xl border border-app-line px-4 py-3 text-sm font-semibold">
                <AppIcon Name="calendar-days" />
                Dzisiaj
            </button>
            <button type="button" @onclick="RefreshCalendarAsync" disabled="@_loading" class="rounded-xl border border-app-line px-4 py-3 text-sm font-semibold">
                <AppIcon Name="refresh-cw" />
                @(_loading ? "Odświeżanie…" : "Odśwież rezerwacje")
            </button>
        </div>
    </div>
    @if (_loading)
    {
        <div class="p-6">
            <LoadingCards Count="2" />
        </div>
    }
    else if (_error is not null)
    {
        <div class="p-5">
            <ErrorNotice Message="@_error" OnRetry="RefreshCalendarAsync" />
        </div>
    }
    else
    {
        var dayReservations = ReservationCalendarHelper.GetDayReservations(_reservations, _selectedDay).ToList();
        var first = new DateTime(_month.Year, _month.Month, 1);
        var gridStart = first.AddDays(-(((int)first.DayOfWeek + 6) % 7));
        <div class="grid min-w-0 lg:grid-cols-2">
            <div class="min-w-0 border-b border-app-line p-3 sm:p-6 lg:border-r lg:border-b-0">
                <div class="mb-4 flex items-center justify-between gap-2">
                    <h3 aria-live="polite" class="font-bold">@_month.ToString("MMMM yyyy", Polish)</h3>
                    <div>
                        <button type="button" aria-label="Poprzedni miesiąc" @onclick="() => MoveMonth(-1)" class="rounded-lg p-3">
                            <AppIcon Name="arrow-left" />
                        </button>
                        <button type="button" aria-label="Następny miesiąc" @onclick="() => MoveMonth(1)" class="rounded-lg p-3">
                            <AppIcon Name="arrow-right" />
                        </button>
                    </div>
                </div>
                <table class="w-full table-fixed text-center" aria-label="Kalendarz rezerwacji">
                    <thead>
                        <tr>
                            @foreach (var label in Weekdays)
                            {
                                <th scope="col" class="py-2 text-xs font-medium text-app-muted">@label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var week = 0; week < 6; week++)
                        {
                            <tr>
                                @for (var index = 0; index < 7; index++)
                                {
                                    var day = gridStart.AddDays(week * 7 + index);
                                    <td class="p-0.5">
                                        <ReservationDayButton
                                            @key="day"
                                            Day="day"
                                            Month="_month"
                                            SelectedDay="_selectedDay"
                                            Reservations="_reservations"
                                            FocusRequested="@(_focusDay == day)"
                                            OnFocused="() => _focusDay = null"
                                            OnSelect="day => _selectedDay = day"
                                            OnKeyDown="e => DayKey(e, day)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 px-2 text-xs text-app-muted">
                    <span class="flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-teal-700"></span>Liczba w dniu: aktywne rezerwacje</span>
                    <span class="flex items-center gap-2"><span aria-hidden="true" class="h-3 w-3 rounded border-2 border-blue-900"></span>Wybrany dzień</span>
                </div>
            </div>
            <div class="min-w-0 bg-slate-50/50 p-5 sm:p-6">
                <div role="status" aria-live="polite">
                    <h3 class="text-base font-bold">@_selectedDay.ToString("dddd, d MMMM yyyy", Polish)</h3>
                    <p class="mt-2 text-sm text-app-muted">Aktywne rezerwacje: @dayReservations.Count</p>
                </div>
                @if (_roomsUnavailable)
                {
                    <p class="mt-3 text-xs text-amber-800">Nazwy sal chwilowo niedostępne. Terminy zostają widoczne.</p>
                }
                @if (dayReservations.Count == 0)
                {
                    <div class="mt-5">
                        <EmptyState Title="Brak spotkań w tym dniu" Description="Nie masz aktywnych rezerwacji na wybrany dzień. Anulowane spotkania nie są zaznaczane.">
                            <a href="/rooms" class="text-sm font-semibold text-blue-700">Znajdź salę</a>
                        </EmptyState>
                    </div>
                }
                else
                {
                    <div class="mt-5 max-h-96 space-y-3 overflow-y-auto pr-1">
                        @foreach (var reservation in dayReservations)
                        {
                            var room = _rooms.FirstOrDefault(room => room.Id == reservation.RoomId);
                            <article data-measurement-calendar-reservation-id="@reservation.Id" @key="reservation.Id" class="rounded-xl border border-app-line bg-white p-4">
                                <h4 class="break-words font-semibold">@reservation.Title</h4>
                                <p
                                    class="mt-2 text-sm leading-6 text-app-muted">@Formatters.FormatDateTime(reservation.StartTime) — @Formatters.FormatDateTime(reservation.EndTime)</p>
                                <a
                                    href="@($"/rooms/{Uri.EscapeDataString(reservation.RoomId)}")"
                                    class="mt-3 inline-block break-words text-sm font-semibold text-blue-700">@(reservation.Room?.Name ?? room?.Name ?? $"Sala: {reservation.RoomId}")</a>
                                <p class="mt-1 text-xs text-app-muted">@(reservation.Room?.Location ?? room?.Location)</p>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="border-t border-app-line px-5 py-4 text-xs leading-5 text-app-muted">
        <p>Kalendarz pokazuje rezerwacje aplikacji. Przy włączonej integracji nowe rezerwacje są wysyłane do Google. Zmiany wykonane w Google nie są pobierane.</p>
        <div class="mt-2 flex flex-wrap justify-between gap-2">
            <a href="/settings" class="font-semibold text-blue-700">Ustawienia Google Calendar</a>
            @if (_updatedAt is not null && !_loading && _error is null)
            {
                <span>Odczyt z aplikacji: @_updatedAt.Value.ToString("HH:mm")</span>
            }
        </div>
    </div>
</section>
