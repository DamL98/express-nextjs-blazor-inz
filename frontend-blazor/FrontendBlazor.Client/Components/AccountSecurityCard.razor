@using FrontendBlazor.Client.Infrastructure.Api
@using FrontendBlazor.Client.Infrastructure.Auth
@using FrontendBlazor.Client.Models.DTOs
@inject ApiClient Api
@inject AuthContext Auth
@inject NavigationManager Navigation

@if (Auth.User?.HasLocalPassword == true)
{
    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold">Konto i logowanie</h2>
        <p class="my-3 text-sm">@(Auth.User.GoogleId is not null ? "Google jest polaczone. Mozesz logowac sie haslem lub przez Google." : "Polacz Google, aby dodac drugi sposob logowania. Dostep do kalendarza wlaczysz osobno ponizej.")</p>
        @if (_callbackMessage is not null) { <p role="status" class="mb-3">@_callbackMessage</p> }
        <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault class="max-w-md space-y-3">
            <label class="block text-sm">Aktualne haslo<input @bind="_currentPassword" type="password" autocomplete="current-password" required maxlength="128" class="mt-1 w-full rounded border p-2" /></label>
            @if (Auth.User.GoogleId is null)
            {
                <button type="button" @onclick="LinkAsync" disabled="@_busy" class="rounded bg-blue-600 px-4 py-2 text-white">Polacz konto Google</button>
            }
            <label class="block text-sm">Nowe haslo (co najmniej 15 znakow)<input @bind="_password" type="password" autocomplete="new-password" minlength="15" maxlength="128" required class="mt-1 w-full rounded border p-2" /></label>
            <button type="submit" disabled="@_busy" class="rounded border px-4 py-2">Zmien haslo</button>
        </form>
        @if (_message is not null) { <p role="status" class="mt-3 text-green-700">@_message</p> }
        @if (_error is not null) { <p role="alert" class="mt-3 text-red-700">@_error</p> }
    </section>
}

@code {
    private string _currentPassword = "", _password = "";
    private string? _error, _message, _callbackMessage;
    private bool _busy;

    protected override void OnInitialized()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        if (query["googleLink"] is string status)
            _callbackMessage = status == "success" ? "Konto Google polaczone." : "Nie udalo sie polaczyc Google. Konto moze juz nalezec do innego uzytkownika; sprobuj ponownie.";
    }

    private Task LinkAsync() => SubmitAsync(true);
    private Task ChangePasswordAsync() => SubmitAsync(false);

    private async Task SubmitAsync(bool link)
    {
        _busy = true; _error = null; _message = null;
        try
        {
            if (link)
            {
                var result = await Api.ApiRequestAsync<AuthResultDto>("/auth/google/link", new ApiRequestOptions {
                    Method = HttpMethod.Post, IsBrowserCredentialRequired = true, Body = new { password = _currentPassword, redirectTo = Navigation.Uri }
                });
                Navigation.NavigateTo(result.AuthorizationUrl, forceLoad: true);
            }
            else
            {
                await Api.ApiRequestAsync<AuthSessionDto>("/auth/password/change", new ApiRequestOptions {
                    Method = HttpMethod.Post, IsBrowserCredentialRequired = true, Body = new { currentPassword = _currentPassword, password = _password }
                });
                _currentPassword = ""; _password = "";
                _message = "Haslo zmienione. Pozostale sesje zostaly uniewaznione.";
            }
        }
        catch (Exception exception) { _error = ApiErrorMessage.FromException(exception, "Operacja nie powiodla sie"); }
        finally { _busy = false; }
    }
}
