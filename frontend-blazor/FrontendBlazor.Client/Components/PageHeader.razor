<header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-blue-700">Twoja przestrzeń do spotkań</p>
        <h1 class="text-3xl font-bold tracking-tight text-app-ink">@Title</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-app-muted">@Description</p>
    </div>
    @if (ChildContent is not null) { <div class="shrink-0">@ChildContent</div> }
</header>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
