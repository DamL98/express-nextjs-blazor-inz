<details open="@(GoogleLink is not null || CalendarStatus is not null)" class="mt-8 rounded-2xl border border-app-line bg-white p-5">
    <summary class="cursor-pointer text-sm font-semibold">Konto i integracja kalendarza</summary>
    <p class="mt-3 text-sm text-app-muted">
        Ustawienia na osobnej stronie
        <a href="/settings" class="text-blue-700 underline">Przejdź do ustawień</a>
    </p>
    <div class="mt-5 space-y-5">
        <AccountSecurityCard />
        <GoogleCalendarIntegrationCard CallbackStatus="@CalendarStatus" CallbackReason="@Reason" />
    </div>
</details>

@code
{
    [SupplyParameterFromQuery(Name = "googleCalendar")]
    public string? CalendarStatus { get; set; }

    [SupplyParameterFromQuery(Name = "googleLink")]
    public string? GoogleLink { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }
}
