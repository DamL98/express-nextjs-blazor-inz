<svg
    aria-hidden="true"
    focusable="false"
    class="@ClassName"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round">
    <use href="@($"/icons/ui-icons.svg#{Name}")"></use>
</svg>

@code
{
    [Parameter]
    public string Name { get; set; } = "calendar-days";
    [Parameter]
    public string ClassName { get; set; } = "mr-2 inline-block size-4 align-[-0.15em]";
}
