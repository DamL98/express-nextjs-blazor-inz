@inherits LayoutComponentBase
<span
    hidden
    data-measurement-renderer="@RendererInfo.Name"
    data-measurement-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
</span>
@if (_isAuthAction)
{
    @Body
}
else if (Auth.Error is not null)
{
    <main role="alert" class="p-8">@Auth.Error</main>
}
else if (Auth.IsLoading || Auth.Error is not null)
{
    <main class="grid min-h-screen place-items-center bg-gray-50 px-4 py-8">
        <div
            class="w-full max-w-login rounded-login border border-blue-900/20 bg-white/97 p-login text-app-ink shadow-login max-login:px-login-mobile max-login:py-7">Ładowanie sesji...</div>
    </main>
}
else if (_isLoginPage && !Auth.IsAuthenticated)
{
    @Body
}
else if (!_isLoginPage && Auth.IsAuthenticated)
{
    <AppShell>
        @Body
    </AppShell>
}
else
{
    <main class="grid min-h-screen place-items-center bg-gray-50 px-4 py-8">
        <div
            class="w-full max-w-login rounded-login border border-blue-900/20 bg-white/97 p-login text-app-ink shadow-login max-login:px-login-mobile max-login:py-7">Przekierowanie...</div>
    </main>
}
