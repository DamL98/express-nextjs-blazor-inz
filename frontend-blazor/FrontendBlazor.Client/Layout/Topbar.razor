@using FrontendBlazor.Client.Features.Auth
@inject AuthContext Auth
@inject NavigationManager Navigation

<header class="border-b border-gray-200 bg-white px-4 py-4 md:px-8">
    <div class="flex items-center justify-between">
        <div class="md:hidden">
            <p class="text-sm font-semibold text-gray-900">Sale konferencyjne</p>
        </div>
        <div class="hidden md:block">
            <p class="text-sm text-gray-500">Panel użytkownika</p>
        </div>

        <div class="flex items-center gap-3">
            <div class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-700">@Auth.User?.Email</div>
            <button
                type="button"
                class="rounded-lg border bg-black px-3 py-1 text-sm font-medium text-white hover:bg-gray-700"
                disabled="@_isLoggingOut"
                @onclick="LogoutAsync">
                @(_isLoggingOut ? "Wylogowywanie..." : "Wyloguj")
            </button>
        </div>
    </div>
</header>

@code {
    private bool _isLoggingOut;

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;

        try
        {
            await Auth.LogoutAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }
}
