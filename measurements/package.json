{
  "name": "measurements",
  "version": "1.0.0",
  "description": "Kontrolowane pomiary E2E aplikacji Next.js i Blazor WebAssembly",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "type": "module",
  "prettier": {
    "printWidth": 90
  },
  "scripts": {
    "test": "playwright test tests/smoke.spec.ts --project=next-small --project=blazor-small",
    "typecheck": "tsc --noEmit",
    "measure:read": "tsx scripts/run-measurements.ts --flow=read",
    "measure:interaction": "tsx scripts/run-measurements.ts --flow=interaction",
    "measure:write": "tsx scripts/run-measurements.ts --flow=write",
    "results:clean": "tsx scripts/clean-results.ts",
    "results:summarize": "tsx scripts/summarize-results.ts",
    "test:unit": "tsx --test unit/*.test.ts",
    "format": "prettier --write scripts tests unit measurement-config.ts playwright.config.ts package.json tsconfig.json",
    "format:check": "prettier --check scripts tests unit measurement-config.ts playwright.config.ts package.json tsconfig.json",
    "measure:pilot": "tsx scripts/run-preset.ts --preset=pilot",
    "measure:all": "tsx scripts/run-preset.ts --preset=all",
    "measure:read:small:fresh": "tsx scripts/run-preset.ts --flow=read --dataset=small --cache=fresh-context",
    "measure:read:small:warm": "tsx scripts/run-preset.ts --flow=read --dataset=small --cache=warm-return",
    "measure:read:medium:fresh": "tsx scripts/run-preset.ts --flow=read --dataset=medium --cache=fresh-context",
    "measure:read:medium:warm": "tsx scripts/run-preset.ts --flow=read --dataset=medium --cache=warm-return",
    "measure:read:large:fresh": "tsx scripts/run-preset.ts --flow=read --dataset=large --cache=fresh-context",
    "measure:read:large:warm": "tsx scripts/run-preset.ts --flow=read --dataset=large --cache=warm-return",
    "measure:write:small:fresh": "tsx scripts/run-preset.ts --flow=write --dataset=small --cache=fresh-context",
    "measure:write:small:warm": "tsx scripts/run-preset.ts --flow=write --dataset=small --cache=warm-return",
    "measure:write:medium:fresh": "tsx scripts/run-preset.ts --flow=write --dataset=medium --cache=fresh-context",
    "measure:write:medium:warm": "tsx scripts/run-preset.ts --flow=write --dataset=medium --cache=warm-return",
    "measure:write:large:fresh": "tsx scripts/run-preset.ts --flow=write --dataset=large --cache=fresh-context",
    "measure:write:large:warm": "tsx scripts/run-preset.ts --flow=write --dataset=large --cache=warm-return",
    "measure:interaction:small:fresh": "tsx scripts/run-preset.ts --flow=interaction --dataset=small --cache=fresh-context",
    "measure:interaction:small:warm": "tsx scripts/run-preset.ts --flow=interaction --dataset=small --cache=warm-return",
    "measure:interaction:medium:fresh": "tsx scripts/run-preset.ts --flow=interaction --dataset=medium --cache=fresh-context",
    "measure:interaction:medium:warm": "tsx scripts/run-preset.ts --flow=interaction --dataset=medium --cache=warm-return",
    "measure:interaction:large:fresh": "tsx scripts/run-preset.ts --flow=interaction --dataset=large --cache=fresh-context",
    "measure:interaction:large:warm": "tsx scripts/run-preset.ts --flow=interaction --dataset=large --cache=warm-return"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "3.9.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
